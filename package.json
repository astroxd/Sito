{
  "name": "AnimeHub",
  "version": "1.0.0",
  "description": "**AnimeHub** è un ecosistema digitale progettato per trasformare la visione dei propri anime in un’esperienza sociale, analitica e gamificata. Sviluppato con **Ionic/Angular** per il client, **Node.js/Express** per il backend e **SQLite3** come database locale.",
  "main": "index.js",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "client",
    "server/packages/*",
    "server/services/*",
    "shared"
  ],
  "scripts": {
    "dev:client": "cd client && ionic serve",
    "dev:all": "npm run dev --workspaces",
    "sync:badges": "npm run sync:badges --workspace=server/services/badge-service",
    "docker:server": "docker compose --profile server up --build",
    "docker:client": "docker compose --profile client up --build",
    "docker:all": "docker compose --profile all up --build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astroxd/AnimeHub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/astroxd/AnimeHub/issues"
  },
  "homepage": "https://github.com/astroxd/AnimeHub#readme",
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
